# ── Discord ──────────────────────────────────────────────────────────────────
# Token bota z https://discord.com/developers/applications
DISCORD_TOKEN=tutaj_wklej_token

# ID twojego serwera Discord (prawy klik na serwer → Kopiuj ID)
GUILD_ID=123456789012345678

# ── Minecraft serwer ─────────────────────────────────────────────────────────
MC_IP=localhost
MC_PORT=25565

# ── RCON (do automatycznej whitelisty) ───────────────────────────────────────
# W server.properties ustaw: enable-rcon=true, rcon.password=..., rcon.port=25575
RCON_HOST=localhost
RCON_PORT=25575
RCON_PASSWORD=twoje_haslo_rcon

# ── IDs kanalów/rol (wpisz po uruchomieniu /setup) ───────────────────────────
# Prawy klik na role/kanal → Kopiuj ID (musisz miec wlaczony tryb dewelopera)
BETA_ROLE_ID=0
STATUS_CHAN_ID=0
BETA_LOG_CHAN_ID=0
LINKED_ROLE_ID=0
LINK_LOG_CHAN_ID=0

# ── DC-MC Link webhook ────────────────────────────────────────────────────────
# Port na którym bot nasłuchuje żądań od pluginu MC (/linkdc <kod>)
# Musi zgadzać się z discord.link-bot-port w plugins/Assasin/config.yml
LINK_BOT_PORT=8642
